<UserControl x:Class="Photobooth.Views.InfoIcon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Grid>
        <ToggleButton x:Name="InfoToggle"
                      Width="16" Height="16"
                      Cursor="Hand"
                      Focusable="False">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="#1E2F4A" CornerRadius="8">
                        <TextBlock Text="i" FontSize="11" FontWeight="Bold" FontStyle="Italic"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>

        <Popup PlacementTarget="{Binding ElementName=InfoToggle}"
               Placement="Bottom"
               IsOpen="{Binding IsChecked, ElementName=InfoToggle, Mode=TwoWay}"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Background="{DynamicResource NavBrush}"
                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="10,8" MaxWidth="220" Margin="0,4,0,0">
                <TextBlock Text="{Binding Text, ElementName=Root}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="12" TextWrapping="Wrap"/>
            </Border>
        </Popup>
    </Grid>
</UserControl>
